validation:
- command:
  - /private/tmp/claude-501/-Users-luiz-Projects-Personal-agentic-delivery-os/beef953a-1025-4848-8464-f8a1fbc3a814/scratchpad/venv/bin/python3
  - -c
  - "import ast, hashlib, json, pathlib, sys\nfor name in json.loads(sys.argv[1]):\n\
    \ p = pathlib.Path(name)\n item = {\"path\": name, \"sha256\": hashlib.sha256(p.read_bytes()).hexdigest()}\n\
    \ if p.suffix == \".py\":\n  tree = ast.parse(p.read_text())\n  item[\"definitions\"\
    ] = [n.name for n in tree.body if isinstance(n, (ast.FunctionDef, ast.ClassDef))]\n\
    \ print(json.dumps(item, sort_keys=True))\n"
  - '["scripts/hds_gate.py", "scripts/hds_validation/__init__.py", "scripts/hds_validation/common.py",
    "scripts/hds_validation/documents.py", "scripts/hds_validation/evolution.py",
    "scripts/hds_validation/links.py", "scripts/hds_validation/registries.py", "scripts/hds_validation/scope.py",
    "scripts/project_hds.py", "scripts/validate_hds.py", "scripts/validate_project_hds.py"]'
