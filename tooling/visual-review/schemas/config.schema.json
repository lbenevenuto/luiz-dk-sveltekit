{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://agentic-os.local/schemas/visual-review/config-1.0.0.json",
  "title":"Visual Review Configuration",
  "type":"object",
  "required":["schemaVersion","project","reference","target","categories","viewports","scenarios","evidence","runtimeDriver"],
  "properties":{
    "schemaVersion":{"const":"1.0.0"},
    "project":{"type":"object","required":["id"]},
    "reference":{"$ref":"#/$defs/source"},
    "target":{"$ref":"#/$defs/source"},
    "categories":{"type":"array","minItems":1,"items":{"type":"object","required":["id","label"]}},
    "viewports":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/viewport"}},
    "scenarios":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/scenario"}},
    "evidence":{"type":"object","required":["root"]},
    "runtimeDriver":{"description":"Validated programmatically because it contains functions."},
    "projectAdapter":{"description":"Validated programmatically because it contains functions."}
  },
  "$defs":{
    "source":{"type":"object","required":["id","label","baseUrls"],"properties":{"id":{"type":"string"},"label":{"type":"string"},"version":{"type":"string"},"immutableRevision":{"type":"string"},"sourceKind":{"type":"string"},"baseUrls":{"type":"object","additionalProperties":{"type":"string"}},"metadata":{"type":"object"}}},
    "viewport":{"type":"object","required":["id","label","width","height"],"properties":{"id":{"type":"string"},"label":{"type":"string"},"width":{"type":"integer","minimum":1},"height":{"type":"integer","minimum":1},"deviceScaleFactor":{"type":"number","exclusiveMinimum":0}}},
    "scenario":{"type":"object","required":["id","name","category","route","state","context","interactions"],"properties":{"id":{"type":"string"},"name":{"type":"string"},"category":{"type":"string"},"route":{"type":"string"},"state":{"type":"string"},"context":{"type":"string"},"viewports":{"type":"array","items":{"type":"string"}},"interactions":{"type":"array"},"expected":{"type":"object"}}}
  }
}
