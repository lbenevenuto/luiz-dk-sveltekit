{
	"name": "luiz-dk-sveltekit",
	"private": true,
	"version": "1.6.18",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "wrangler pages dev .svelte-kit/cloudflare --port 4173",
		"prepare": "bun run types && svelte-kit sync || echo '' && husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "bun run test:unit -- --run",
		"types": "wrangler types",
		"deploy": "CF_PAGES=1 bun run build && CF_PAGES=1 wrangler pages deploy",
		"tail:pages": "wrangler pages deployment tail --project-name luiz-dk-sveltekit",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate:prod": "drizzle-kit migrate --config=drizzle.prod.config.ts",
		"db:push": "drizzle-kit push",
		"clear": "rm -rf node_modules/ .svelte-kit/ .wrangler/ dist/ coverage/ pnpm-lock.yaml bun.lockb bun.lock package-lock.json yarn.lock"
	},
	"lint-staged": {
		"*.{js,ts,svelte,json}": [
			"prettier --write",
			"eslint"
		]
	},
	"devDependencies": {
		"@clerk/backend": "^3.26.6",
		"@clerk/themes": "^2.4.62",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/git": "^11.0.1",
		"@sentry/sveltekit": "^11.10.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.4",
		"@types/better-sqlite3": "^9.6.0",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.2.0",
		"@vitest/coverage-v8": "^5.1.0",
		"better-sqlite3": "^13.0.3",
		"conventional-changelog-conventionalcommits": "~10.3.0",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^17.14.0",
		"hashids": "^2.3.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"semantic-release": "^25.0.9",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svix": "^2.9.1",
		"tailwindcss": "^4.3.4",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.1.0",
		"wrangler": "4.153.0",
		"zod": "^4.6.7"
	},
	"dependencies": {
		"d3-scale": "^4.0.3",
		"d3-shape": "^3.2.1",
		"layercake": "^10.0.3"
	},
	"overrides": {
		"@tailwindcss/typography>postcss-selector-parser": "6.1.5"
	}
}
